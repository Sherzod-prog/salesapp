generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  MANAGER
}

enum PaymentMethod {
  CASH
  CARD
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockIns StockIn[]
  sales    Sale[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  stockIns  StockIn[]

  @@map("suppliers")
}

model Product {
  id         String    @id @default(uuid())
  name       String
  sku        String?   @unique
  unit       String    @default("dona")
  sellPrice  Decimal   @db.Decimal(14, 2)
  minStock   Decimal   @default(0) @db.Decimal(14, 3)
  isActive   Boolean   @default(true)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stock        Stock?
  stockInItems StockInItem[]
  saleItems    SaleItem[]

  @@map("products")
}

// Har bir mahsulotning joriy ombor qoldig'i va o'rtacha tannarxi (weighted average cost)
model Stock {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  avgCost   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  @@map("stocks")
}

// Tovar kirimi (partiya) hujjati
model StockIn {
  id         String    @id @default(uuid())
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  note       String?
  totalCost  Decimal   @default(0) @db.Decimal(14, 2)
  createdAt  DateTime  @default(now())

  items StockInItem[]

  @@map("stock_ins")
}

model StockInItem {
  id        String  @id @default(uuid())
  stockInId String
  stockIn   StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  costPrice Decimal @db.Decimal(14, 2)

  @@map("stock_in_items")
}

// Kassa savdosi (chek) hujjati
model Sale {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  paymentMethod PaymentMethod @default(CASH)
  totalAmount   Decimal       @default(0) @db.Decimal(14, 2)
  totalProfit   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())

  items SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  sellPrice Decimal @db.Decimal(14, 2)
  costPrice Decimal @db.Decimal(14, 2)

  @@map("sale_items")
}
